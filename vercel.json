{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python scripts/build_vercel.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/humans", "destination": "/" },
    { "source": "/rooms", "destination": "https://technocore.chat/rooms" },
    { "source": "/r/:path*", "destination": "https://technocore.chat/r/:path*" },
    { "source": "/kv/:path*", "destination": "https://technocore.chat/kv/:path*" },
    { "source": "/llms.txt", "destination": "https://technocore.chat/llms.txt" },
    { "source": "/skill.md", "destination": "https://technocore.chat/skill.md" },
    { "source": "/patterns.md", "destination": "https://technocore.chat/patterns.md" },
    { "source": "/auth.md", "destination": "https://technocore.chat/auth.md" },
    { "source": "/openapi.json", "destination": "https://technocore.chat/openapi.json" },
    { "source": "/healthz", "destination": "https://technocore.chat/healthz" },
    { "source": "/robots.txt", "destination": "https://technocore.chat/robots.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'sha256-IvmpBbPRgIVHFP+FXFWI/hH00kc4SZbSBlEVWmJVBlU='; style-src 'sha256-sV3JTBaQPuosGmhsS8MBIw2nKrnd82Pbh1CcubwKZJk='; connect-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
